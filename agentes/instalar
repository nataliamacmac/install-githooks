#!/usr/bin/env python3
# install-githooks managed
"""Instala o git_guard como hook PreToolUse do Claude Code. O install.sh chama este script.

Uso: <python> agentes/instalar <comando-do-python>

A pasta de configuração é CLAUDE_CONFIG_DIR ou <home>/.claude, em que <home> é GITHOOKS_HOME ou HOME. Fontes na
documentação oficial:
- code.claude.com/docs/en/settings, "Find or create your settings files": CLAUDE_CONFIG_DIR troca a pasta.
- code.claude.com/docs/en/hooks, "Configuration": hooks > PreToolUse > [{matcher, hooks: [{type, command}]}] no
  settings.json do usuário.
- code.claude.com/docs/en/hooks, "Command hook fields": no Windows o comando roda no Git Bash, ou no PowerShell sem
  Git Bash. Por isso o comando usa o caminho absoluto com barras normais.

Se a pasta não existe, o Claude Code não está instalado e nada muda. Um settings.json inválido não é sobrescrito.
"""
import datetime
import json
import os
import shutil
import sys
from pathlib import Path

ORIGEM = Path(__file__).resolve().parent / "git_guard.py"


def pasta_de_configuracao():
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        return Path(os.environ["CLAUDE_CONFIG_DIR"])
    home = os.environ.get("GITHOOKS_HOME") or os.environ.get("HOME") or str(Path.home())
    return Path(home) / ".claude"


def eh_entrada_da_guarda(entrada):
    return any("git_guard.py" in str(h.get("command", "")) for h in entrada.get("hooks", []) if isinstance(h, dict))


def registrar(dados, comando):
    """Põe uma única entrada Bash do git_guard em hooks.PreToolUse. Devolve True se algo mudou."""
    entrada = {"matcher": "Bash", "hooks": [{"type": "command", "command": comando, "timeout": 10,
                                             "statusMessage": "Trava git: conferindo"}]}
    pre = dados.setdefault("hooks", {}).setdefault("PreToolUse", [])
    guardas = [i for i, e in enumerate(pre) if isinstance(e, dict) and eh_entrada_da_guarda(e)]
    if len(guardas) == 1 and pre[guardas[0]] == entrada:
        return False
    if guardas:
        pre[guardas[0]] = entrada
        for i in reversed(guardas[1:]):
            del pre[i]
    else:
        pre.append(entrada)
    return True


def main():
    python = sys.argv[1] if len(sys.argv) > 1 else "python3"
    pasta = pasta_de_configuracao()
    if not pasta.is_dir():
        print(f"git_guard: {pasta} não existe. O Claude Code não está instalado, nada foi feito.")
        return 0

    destino = pasta / "hooks" / "git_guard.py"
    destino.parent.mkdir(parents=True, exist_ok=True)
    if not destino.exists() or destino.read_bytes() != ORIGEM.read_bytes():
        shutil.copyfile(ORIGEM, destino)

    settings = pasta / "settings.json"
    dados = {}
    if settings.exists():
        try:
            dados = json.loads(settings.read_text(encoding="utf-8"))
        except ValueError as erro:
            print(f"git_guard: {settings} não é um JSON válido ({erro}). Corrija o arquivo e rode o install.sh de novo.")
            return 1
        if not isinstance(dados, dict):
            print(f"git_guard: {settings} não é um objeto JSON. Nada foi gravado.")
            return 1

    comando = f'{python} -I "{destino.as_posix()}"'
    if not registrar(dados, comando):
        print(f"git_guard: já registrado em {settings}")
        return 0

    if settings.exists():
        backup = settings.with_name(f"settings.json.backup.{datetime.datetime.now():%Y%m%d%H%M%S}")
        shutil.copy2(settings, backup)
        print(f"Backup: {backup}")
    temporario = settings.with_name(f"settings.json.tmp.{os.getpid()}")
    temporario.write_text(json.dumps(dados, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(temporario, settings)
    print(f"git_guard: registrado em {settings}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
