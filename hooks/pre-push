#!/bin/sh
# install-githooks managed

HOOK_DIR="$(dirname "$0")"
FALHA=0
EU=$("$HOOK_DIR/_email_committer")
ENTRADA=$(mktemp)
trap 'rm -f "$ENTRADA"' EXIT HUP INT TERM
cat > "$ENTRADA"

listar_commits() {
  if [ -n "$EU" ]; then
    git rev-list --fixed-strings --committer="<$EU>" "$@"
  else
    git rev-list "$@"
  fi
}

while IFS=' ' read -r REF_LOCAL OID_LOCAL REF_REMOTA OID_REMOTO; do
  [ -z "$REF_LOCAL" ] && continue
  if ! printf '%s\n' "$REF_LOCAL" | "$HOOK_DIR/_bloquear_termos_ia" "referência local"; then FALHA=1; fi
  if ! printf '%s\n' "$REF_REMOTA" | "$HOOK_DIR/_bloquear_termos_ia" "referência remota"; then FALHA=1; fi

  case "$OID_LOCAL" in
    ''|*[!0]*) ;;
    *) continue ;;
  esac
  case "$OID_REMOTO" in
    ''|*[!0]*)
      if git cat-file -e "$OID_REMOTO^{commit}" 2>/dev/null; then
        COMMITS=$(listar_commits "$OID_LOCAL" "^$OID_REMOTO" 2>/dev/null) || { echo 'Git bloqueado: falha ao listar commits enviados.'; FALHA=1; continue; }
      else
        COMMITS=$(listar_commits "$OID_LOCAL" 2>/dev/null) || { echo 'Git bloqueado: falha ao listar commits enviados.'; FALHA=1; continue; }
      fi
      ;;
    *) COMMITS=$(listar_commits "$OID_LOCAL" 2>/dev/null) || { echo 'Git bloqueado: falha ao listar commits enviados.'; FALHA=1; continue; } ;;
  esac

  for COMMIT in $COMMITS; do
    MENSAGEM=$(git show -s --format=%B "$COMMIT") || { echo 'Git bloqueado: falha ao ler commit enviado.'; FALHA=1; continue; }
    if ! printf '%s\n' "$MENSAGEM" | "$HOOK_DIR/_bloquear_termos_ia" "mensagem do commit $COMMIT"; then FALHA=1; fi
    if ! printf '%s\n' "$MENSAGEM" | "$HOOK_DIR/_bloquear_atribuicao_ia" "mensagem do commit $COMMIT"; then FALHA=1; fi
  done
done < "$ENTRADA"

if [ "$FALHA" -ne 0 ]; then exit 1; fi
"$HOOK_DIR/_delegar" pre-push "$@" < "$ENTRADA"
RESULTADO=$?
rm -f "$ENTRADA"
trap - EXIT HUP INT TERM
exit "$RESULTADO"