#!/usr/bin/env bash
# install-githooks managed
#
# Mantém a lista particular de repos só leitura desta máquina e as regras pushInsteadOf que vêm dela.
# A lista nunca vai para nenhum repositório: fica em ~/.config/git/somente-leitura.lista.
set -euo pipefail

LISTA="${XDG_CONFIG_HOME:-${HOME:?HOME precisa estar definido}/.config}/git/somente-leitura.lista"
BLOQUEIO="somente-leitura://bloqueado/"
CHAVE="url.$BLOQUEIO.pushInsteadOf"

uso() {
  cat <<'TEXTO'
Uso: somente-leitura <comando>
  adicionar               trava o repo da pasta atual pela URL do remoto origin
  adicionar url:<prefixo> trava os remotos que começam com o prefixo
  adicionar pasta:<pasta> trava os repos dentro da pasta
  listar                  mostra a lista
  remover <entrada>       tira da lista (só no terminal, com confirmação)
  aplicar                 regrava as regras pushInsteadOf a partir da lista
TEXTO
}

sem_credencial() {
  printf '%s\n' "$1" | sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/@]*@#\1#'
}

entradas() {
  [[ -f "$LISTA" ]] || return 0
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' "$LISTA" | grep -E '^(url|pasta):.' || true
}

aplicar() {
  git config --global --unset-all "$CHAVE" 2>/dev/null || true
  local entrada
  while IFS= read -r entrada; do
    [[ "$entrada" == url:* ]] || continue
    git config --global --add "$CHAVE" "${entrada#url:}"
  done < <(entradas)
}

avisar_hooks_proprios() {
  local repo="$1" caminho
  caminho="$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null || true)"
  [[ -n "$caminho" ]] || return 0
  printf 'Aviso: %s tem core.hooksPath local (%s).\n' "$repo" "$caminho"
  printf '  O envio fica bloqueado pela regra pushInsteadOf. Commit local não, porque os hooks globais não rodam ali.\n'
  printf '  Para os hooks globais rodarem, troque core.hooksPath por hooks.versionado (veja scan-custom-hooks.sh).\n'
}

adicionar() {
  local entrada="${1:-}" repo url pasta
  if [[ -z "$entrada" ]]; then
    repo="$(git rev-parse --show-toplevel 2>/dev/null)" || { printf 'Fora de um repositório git. Informe url:<prefixo> ou pasta:<pasta>.\n' >&2; exit 2; }
    if url="$(git config --get remote.origin.url 2>/dev/null)"; then
      entrada="url:$(sem_credencial "$url")"
    else
      entrada="pasta:$(cd "$repo" && pwd -P)"
    fi
    avisar_hooks_proprios "$repo"
  fi
  case "$entrada" in
    url:?*) entrada="url:$(sem_credencial "${entrada#url:}")" ;;
    pasta:?*)
      pasta="${entrada#pasta:}"
      pasta="${pasta/#\~/$HOME}"
      pasta="$(cd "$pasta" 2>/dev/null && pwd -P)" || { printf 'Pasta não encontrada: %s\n' "${entrada#pasta:}" >&2; exit 2; }
      entrada="pasta:$pasta"
      ;;
    *) uso >&2; exit 2 ;;
  esac
  mkdir -p "$(dirname "$LISTA")"
  if entradas | grep -xF -- "$entrada" >/dev/null; then
    printf 'Já está na lista: %s\n' "$entrada"
  else
    printf '%s\n' "$entrada" >> "$LISTA"
    printf 'Travado: %s\n' "$entrada"
  fi
  aplicar
}

remover() {
  local entrada="${1:-}" resposta
  [[ -n "$entrada" ]] || { uso >&2; exit 2; }
  if ! { true < /dev/tty; } 2>/dev/null; then
    printf 'Recusado: remover só funciona no terminal, com confirmação de quem usa a máquina.\n' >&2
    exit 1
  fi
  entradas | grep -xF -- "$entrada" >/dev/null || { printf 'Não está na lista: %s\n' "$entrada" >&2; exit 1; }
  printf 'Destravar %s? Digite sim para confirmar: ' "$entrada" > /dev/tty
  IFS= read -r resposta < /dev/tty
  [[ "$resposta" == sim ]] || { printf 'Nada mudou.\n'; exit 1; }
  local temporario
  temporario="$(mktemp)"
  grep -vxF -- "$entrada" "$LISTA" > "$temporario" || true
  mv -f "$temporario" "$LISTA"
  aplicar
  printf 'Destravado: %s\n' "$entrada"
}

case "${1:-}" in
  adicionar) shift; adicionar "${1:-}" ;;
  listar) entradas ;;
  remover) shift; remover "${1:-}" ;;
  aplicar) aplicar ;;
  -h|--help|"") uso ;;
  *) uso >&2; exit 2 ;;
esac
